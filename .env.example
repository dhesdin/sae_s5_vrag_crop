# Copy this file to .env and adapt the values to your machine:  cp .env.example .env

# Ollama server URL. IUT server (IUT network only) or http://localhost:11434 for a local Ollama.
VCROP_OLLAMA_URL=http://10.X.X.X:XXXX

# Vision model used to describe images
VCROP_VLM_MODEL=qwen3-vl:8b-instruct

# Embedding model. Changing it requires re-indexing everything (vectors are not comparable between models)
VCROP_EMBEDDING_MODEL=embeddinggemma:latest
